{
  "name": "airon-extension",
  "version": "3.0.0",
  "description": "AIron - Extension Chrome IA pour génération de scripts, analyse web et automatisation",
  "main": "index.js",
  "sideEffects": [
    "./src/background/*.ts"
  ],
  "browserslist": [
    "chrome >= 112",
    "firefox >= 112"
  ],
  "scripts": {
    "build": "npm run build:dev",
    "build:dev": "webpack --config webpack.config.js --mode=development",
    "build:prod": "webpack --config webpack.config.js --mode=production && cd dist && zip -r xyph-agent.zip .",
    "watch": "webpack --config webpack.config.js --mode=development --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest"
  },
  "keywords": [
    "chrome-extension",
    "ai-agent",
    "image-processing",
    "video-editing",
    "automation",
    "script-generation"
  ],
  "author": "XYPH Development Team",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@types/chrome": "^0.0.245",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "babel-loader": "^9.1.0",
    "clsx": "^2.0.0",
    "css-loader": "^6.8.0",
    "fabric": "^5.3.0",
    "ffmpeg.wasm": "^0.12.6",
    "html2canvas": "^1.4.1",
    "immer": "^10.0.0",
    "jimp": "^0.22.10",
    "lodash.debounce": "^4.0.8",
    "opencv-js": "^4.8.0",
    "postcss": "^8.4.0",
    "postcss-loader": "^7.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "style-loader": "^3.3.0",
    "tensorflow": "^4.10.0",
    "tesseract.js": "^4.1.0",
    "typescript": "^5.2.0",
    "uuid": "^9.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/lodash.debounce": "^4.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "copy-webpack-plugin": "^11.0.0",
    "cssnano": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-jest": "^29.1.0"
  }
}