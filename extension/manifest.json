{
  "manifest_version": 3,
  "name": "AIron",
  "version": "3.0",
  "description": "IA puissante pour générer, analyser et automatiser vos scripts et pages web",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://api-inference.huggingface.co/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "http://localhost:11434/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Ouvrir le panneau AI Script Commander",
    "default_popup": "ui/popup/popup.html"
  },
  "side_panel": {
    "default_path": "ui/sidebar/sidebar.html"
  },
  "background": {
    "service_worker": "core/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/content.js"],
      "css": ["ui/styles/content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      }
    }
  }
}